# arch-i3-minimal — i3 config
# ThinkPad T14 Gen2i / Intel Xe / clean minimal, no compositor
# Keybinds ported from Omarchy (Hyprland) muscle memory

set $mod Mod4
set $term alacritty
set $browser firefox
set $files thunar
set $menu rofi -show drun
set $lock i3lock -c 1a1a1a
set $menuroot ~/.config/rofi/menu.sh
set $menusys ~/.config/rofi/menu.sh system

font pango:JetBrainsMono Nerd Font 10

# gaps (i3 >= 4.22 has gaps built in)
gaps inner 4
gaps outer 4
smart_gaps on
smart_borders on

# colors — monochrome dark minimal
set $bg     #1a1a1a
set $bg2    #2a2a2a
set $fg     #d4d4d4
set $dim    #767676
set $border #3a3a3a
set $accent #808080

client.focused          $accent $bg2 $fg $accent $accent
client.focused_inactive $border $bg  $dim $border $border
client.unfocused        $border $bg  $dim $border $border
client.urgent           #5f0000 #900000 $fg #900000 #900000

# floating terminals for pkg TUIs + agent (Omarchy floating-presentation feel)
for_window [class="^pkg$"] floating enable, resize set 900 600, move position center
for_window [class="^agent$"] floating enable, resize set 1100 700, move position center

# bar: we use polybar, disable i3bar
bar {
  mode invisible
}

# autostart
exec_always --no-startup-id ~/.config/polybar/launch.sh
exec --no-startup-id feh --bg-fill ~/.wallpaper 2>/dev/null || xsetroot -solid "#1a1a1a"
exec --no-startup-id dunst
exec --no-startup-id nm-applet --indicator
exec --no-startup-id udiskie --automount --no-notify --no-tray
exec --no-startup-id xss-lock -- $lock
exec --no-startup-id clipmenud
exec --no-startup-id xset r rate 250 40

# ---- applications (Omarchy style) ----
bindsym $mod+Return exec $term
bindsym $mod+Shift+Return exec $browser
bindsym $mod+Shift+f exec $files
bindsym $mod+space exec $menu
bindsym $mod+Mod1+space exec $menuroot
bindsym $mod+Ctrl+q exec rofi -show calc -modi calc
bindsym $mod+Ctrl+e exec rofi -show emoji -modi emoji
bindsym $mod+Ctrl+v exec clipmenu
bindsym $mod+Escape exec $menusys
bindsym $mod+k exec alacritty -e less ~/arch-i3-minimal/docs/KEYBINDS.md
bindsym $mod+Ctrl+r exec alacritty -e arch-reminder set
# ---- agentic workflow (Omarchy parity) ----
bindsym $mod+a exec arch-agent
bindsym $mod+Shift+Ctrl+a exec arch-agent --pick
bindsym $mod+grave exec rofi -show window

# ---- window management (Omarchy style) ----
bindsym $mod+w kill
bindsym $mod+j split toggle
bindsym $mod+t floating toggle
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+Shift+space exec arch-toggle bar
# ---- toggles (Omarchy trigger.toggle port) ----
bindsym XF86TouchpadToggle exec arch-toggle touchpad

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
# Omarchy swaps with shift+arrows (not move)
bindsym $mod+Shift+Left swap left
bindsym $mod+Shift+Down swap down
bindsym $mod+Shift+Up swap up
bindsym $mod+Shift+Right swap right

# workspace cycling (Omarchy style)
bindsym $mod+Tab workspace next
bindsym $mod+Shift+Tab workspace prev

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

# ---- universal clipboard (Omarchy SUPER+C/V/X via xclip) ----
bindsym $mod+c exec "xclip -selection clipboard -o | xclip -selection primary -i 2>/dev/null; true"
bindsym $mod+v exec "xdotool key --clearmodifiers Shift+Insert"
bindsym $mod+x exec "xclip -selection clipboard -o | head -c 1000000 | xclip -selection clipboard -i; xdotool key --clearmodifiers Shift+Delete"

# ---- system ----
bindsym $mod+l exec arch-system lock
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec arch-system logout
bindsym $mod+Ctrl+n exec arch-toggle nightlight

# ---- screenshots + capture (arch-capture) ----
bindsym Print exec arch-capture screenshot full
bindsym $mod+Print exec arch-capture screenshot region
bindsym Shift+Print exec arch-capture screenshot region
bindsym $mod+Ctrl+Print exec arch-capture ocr
bindsym $mod+Shift+Print exec arch-capture color
bindsym Mod1+Print exec arch-capture record

# ---- volume (pamixer + PipeWire) ----
bindsym XF86AudioRaiseVolume exec pamixer -i 5
bindsym XF86AudioLowerVolume exec pamixer -d 5
bindsym XF86AudioMute exec pamixer -t
bindsym XF86AudioMicMute exec pamixer --default-source -t
bindsym Shift+XF86MonBrightnessUp exec brightnessctl set 100%
bindsym Shift+XF86MonBrightnessDown exec brightnessctl set 1%

# ---- brightness (ThinkPad) ----
bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# ---- media ----
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous
