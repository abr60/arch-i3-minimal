[global]
    font = JetBrainsMono Nerd Font 9
    frame_color = "#3a3a3a"
    separator_color = "#3a3a3a"

[urgency_low]
    background = "#1a1a1a"
    foreground = "#d4d4d4"
    timeout = 5

[urgency_normal]
    background = "#1a1a1a"
    foreground = "#d4d4d4"
    timeout = 8

[urgency_critical]
    background = "#900000"
    foreground = "#ffffff"
    timeout = 0
