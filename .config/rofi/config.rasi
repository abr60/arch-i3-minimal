configuration {
  modi: "drun";
  show-icons: false;
  font: "JetBrainsMono Nerd Font 10";
  drun-display-format: "{name}";
}
@theme "gruvbox-dark-hard"
* {
  background-color: #1a1a1a;
  foreground-color: #d4d4d4;
  border-color: #3a3a3a;
}
window {
  width: 480px;
  border: 1;
  padding: 12;
}
listview { lines: 10; }
element-selected { background-color: #2a2a2a; text-color: #ffffff; }
