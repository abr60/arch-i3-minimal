#!/bin/bash
# arch-default-agent — get/set default coding agent (Omarchy omarchy-default-agent port for i3)
# Usage: arch-default-agent [--install] [pi|omp|opencode|claude|codex|grok|gemini|openclaw|hermes|copilot|crush|cursor-agent|muse]
set -euo pipefail
installing=false
if [[ ${1:-} == "--install" ]]; then installing=true; shift; fi
agent_file="$HOME/.config/arch-i3-minimal/defaults/agent"
compat_file="$HOME/.config/omarchy/defaults/agent"
if (($# == 0)); then
  if [[ -f $agent_file ]]; then read -r agent <"$agent_file"
  elif [[ -f $compat_file ]]; then read -r agent <"$compat_file"
  fi
  [[ -n ${agent:-} ]] && echo "$agent"
  exit 0
fi
case "$1" in
  pi) agent="pi"; name="Pi" ;;
  omp|oh-my-pi) agent="omp"; name="Oh My Pi"; agent_package="github:can1357/oh-my-pi" ;;
  opencode|open-code) agent="opencode"; name="OpenCode" ;;
  claude|claude-code) agent="claude"; name="Claude Code" ;;
  codex) agent="codex"; name="Codex" ;;
  crush) agent="crush"; name="Crush" ;;
  grok) agent="grok"; name="Grok"; agent_package="npm:@xai-official/grok" ;;
  gemini|gemini-cli) agent="gemini"; name="Gemini" ;;
  openclaw) agent="openclaw"; name="OpenClaw"; agent_installer="omarchy-install-openclaw-cli" ;;
  hermes) agent="hermes"; name="Hermes"; agent_installer="omarchy-install-hermes-cli" ;;
  copilot|github-copilot) agent="copilot"; name="GitHub Copilot" ;;
  muse|muse-code|musecode) agent="muse"; name="Muse Code"; agent_package="http:muse[url=https://api.meta.ai/muse-launcher.sh,bin=muse,version_list_url=https://api.meta.ai/muse-code/channels/muse-stable,version_json_path=.version]" ;;
  cursor|cursor-agent) agent="cursor-agent"; name="Cursor CLI" ;;
  *) echo "Usage: arch-default-agent <pi|omp|opencode|claude|codex|grok|gemini|openclaw|hermes|copilot|crush|cursor-agent|muse>" >&2; exit 1 ;;
esac
agent_package=${agent_package:-$agent}
if [[ -n ${agent_installer:-} ]]; then
  agent_present() { "$agent_installer" --check 2>/dev/null; }
  agent_install() { "$agent_installer" --now 2>/dev/null; }
else
  user_install() { [[ -x $HOME/.local/bin/$agent ]] && { [[ -L $HOME/.local/bin/$agent ]] || ! grep -q '^mise use -g' "$HOME/.local/bin/$agent" 2>/dev/null; }; }
  agent_present() { user_install || mise where "$agent_package" >/dev/null 2>&1; }
  agent_install() { user_install || mise use -g "$agent_package" 2>/dev/null; }
fi
if [[ $installing == "false" ]] && ! agent_present 2>/dev/null; then
  # launch floating presentation terminal with install (i3 uses alacritty, not omarchy wrapper)
  exec alacritty --class agent -e bash -c "arch-default-agent --install $agent; echo done; read -n1" 2>/dev/null || arch-default-agent --install "$agent"
fi
if ! agent_install 2>/dev/null; then
  if [[ $installing == "true" ]]; then echo "Could not install $name with mise" >&2; else echo "Could not set $name as the default coding agent" >&2; fi
  exit 1
fi
mkdir -p "$(dirname "$agent_file")" "$(dirname "$compat_file")"
printf '%s\n' "$agent" >"$agent_file"
printf '%s\n' "$agent" >"$compat_file"
if [[ $installing == "true" ]]; then
  printf '\033[2J\033[3J\033[H'
  exec arch-agent --inline 2>/dev/null || exec "$agent"
else
  exec arch-agent 2>/dev/null || echo "Default agent set to $name ($agent)"
fi
